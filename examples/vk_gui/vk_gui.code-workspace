	"settings": {
		"makefile.launchConfigurations": [
			{
				"cwd": "${workspaceFolder}",
				"binaryPath": "${workspaceFolder}/stappler-build/host/debug/clang/testapp",
				"binaryArgs": []
			},
			{
				"cwd": "${workspaceFolder}",
				"binaryPath": "${workspaceFolder}/stappler-build/host/clang/gcc/testapp",
				"binaryArgs": []
			},
			{
				"cwd": "${workspaceFolder}",
				"binaryPath": "${workspaceFolder}\\stappler-build\\host\\debug\\clang\\testapp.exe",
				"binaryArgs": []
			}
		],
		"makefile.configurations": [
			{
				"name" : "Debug",
				"makeArgs": [
					"-j8",
				]
			}
		],
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
		"clangd.arguments": ["-header-insertion=never", "--compile-commands-dir=${workspaceFolder}"],
		"debug.allowBreakpointsEverywhere": true
	}
